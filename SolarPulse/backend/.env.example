# SolarPulse Backend Configuration
# Copy to .env and adjust as needed

# Open-Meteo API (no key required, but can set custom base URL)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# EcoFlow MQTT / Cloud (optional, for future integration)
ECOFLOW_MQTT_HOST=
ECOFLOW_MQTT_PORT=1883
ECOFLOW_MQTT_USERNAME=
ECOFLOW_MQTT_PASSWORD=
ECOFLOW_DEVICE_SN=

# Database
DATABASE_URL=sqlite:///./solarpulse.db

# Server
HOST=0.0.0.0
PORT=8000

# Logging
LOG_LEVEL=INFO